<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="0" prefWidth="420.0" prefHeight="540.0" 
      style="-fx-background-color: #f1f5f9;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.klinik.app.controller.LoginController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <VBox alignment="CENTER" spacing="18.0" styleClass="card" maxWidth="380.0">
         <padding>
            <Insets bottom="32.0" left="28.0" right="28.0" top="32.0" />
         </padding>
         <children>
            <!-- Header Icon & Branding -->
            <VBox alignment="CENTER" spacing="6.0">
               <Label text="🏥" style="-fx-font-size: 38px;" />
               <Label text="MYCLINIC" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
               <Label text="Portal Dokter dan Admin" styleClass="text-muted" textAlignment="CENTER" wrapText="true" />
            </VBox>

            <Region prefHeight="4.0" />

            <!-- Input Fields -->
            <VBox spacing="6.0" alignment="CENTER_LEFT" maxWidth="Infinity">
               <Label text="Username" styleClass="text-label" />
               <TextField fx:id="txtUsernameOrNik" promptText="Masukkan username" prefHeight="38.0" maxWidth="Infinity" />
            </VBox>

            <VBox spacing="6.0" alignment="CENTER_LEFT" maxWidth="Infinity">
               <Label text="Password" styleClass="text-label" />
               <PasswordField fx:id="txtPassword" promptText="Masukkan password" prefHeight="38.0" maxWidth="Infinity" />
            </VBox>

            <Button fx:id="btnLogin" text="Masuk" onAction="#handleLogin" prefHeight="40.0" maxWidth="Infinity"
                    styleClass="btn-primary" defaultButton="true" />

            <VBox alignment="CENTER" spacing="6.0">
               <Label text="Ingin ambil antrean berobat?" styleClass="text-muted" />
               <Hyperlink text="Anjungan Pendaftaran Mandiri" onAction="#handleKeHalamanDaftarPasien"
                          style="-fx-font-weight: bold; -fx-text-fill: #0284c7;" />
            </VBox>

            <!-- Status Koneksi Database -->
            <HBox alignment="CENTER" spacing="6.0" style="-fx-padding: 8 0 0 0;">
               <Label fx:id="lblStatusDb" text="Memeriksa koneksi database..." styleClass="text-muted" />
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
