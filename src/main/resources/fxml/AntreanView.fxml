<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" style="-fx-background-color: #f8fafc;" 
      stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.klinik.app.controller.AntreanController">
    <padding>
        <Insets top="16.0" right="20.0" bottom="16.0" left="20.0"/>
    </padding>

    <!-- Header & Statistics -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="2.0">
            <Label text="Manajemen Antrean Klinik" styleClass="title-page"/>
            <Label text="Sistem antrean cerdas berbasis Prioritas Triase (Merah > Kuning > Hijau)" styleClass="text-muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblAutoRefreshStatus" text="● Auto-refresh (5s)" styleClass="badge, badge-hijau" style="-fx-font-size: 12px; -fx-padding: 6 12;"/>
        <Label fx:id="lblQueueStats" text="Total Antrean: 0 orang" styleClass="badge, badge-primary" style="-fx-font-size: 13px; -fx-padding: 6 12;"/>
        <Button text="🔄 Refresh" onAction="#loadDataAntrean" styleClass="btn-outline"/>
    </HBox>

    <!-- Priority Queue Call Board (Hero Card) -->
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="card" 
          style="-fx-background-color: #ffffff; -fx-border-color: #bae6fd; -fx-border-width: 1.5px;">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label text="PANGGILAN PASIEN BERIKUTNYA" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #0369a1;"/>
            <Label fx:id="lblPasienBerikutnya" text="Memuat antrean berikutnya..." 
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
        </VBox>
        <Button fx:id="btnPanggil" text="🔊 Panggil Pasien Berikutnya" onAction="#handlePanggilPasienBerikutnya" 
                styleClass="btn-warning" style="-fx-font-size: 13px; -fx-padding: 10 18;"/>
    </HBox>

    <!-- Admin Input Panel (Hanya muncul untuk Admin) -->
    <VBox fx:id="boxAdminInputs" spacing="10.0" styleClass="card">
        <Label text="Tambah Antrean Pasien Baru (Penetapan Dokter &amp; Triase)" styleClass="title-section"/>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label text="Pasien:" styleClass="text-label"/>
                <ComboBox fx:id="cbPasien" promptText="-- Pilih Pasien Terdaftar --" maxWidth="Infinity" prefHeight="35.0"/>
            </VBox>

            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label text="Dokter Pemeriksa:" styleClass="text-label"/>
                <ComboBox fx:id="cbDokter" promptText="-- Pilih Dokter Tujuan --" maxWidth="Infinity" prefHeight="35.0"/>
            </VBox>

            <VBox spacing="4.0" prefWidth="100.0">
                <Label text="No Antrean:" styleClass="text-label"/>
                <TextField fx:id="txtNoAntrean" promptText="Auto" prefHeight="35.0"/>
            </VBox>

            <VBox spacing="4.0" prefWidth="130.0">
                <Label text="Triase Urgensi:" styleClass="text-label"/>
                <ComboBox fx:id="cbTingkatUrgensi" maxWidth="Infinity" prefHeight="35.0"/>
            </VBox>

            <VBox spacing="4.0" alignment="BOTTOM_LEFT">
                <Label text=" "/>
                <Button fx:id="btnTambahAntrean" text="+ Tambah Antrean" onAction="#handleTambahAntrean" 
                        styleClass="btn-primary" prefHeight="35.0"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Table of Current Active Queues -->
    <VBox spacing="8.0" VBox.vgrow="ALWAYS" styleClass="card">
        <Label text="Daftar Antrean Pasien Hari Ini" styleClass="title-section"/>
        <TableView fx:id="tableAntrean" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNoAntrean" text="No" prefWidth="65.0"/>
                <TableColumn fx:id="colNamaPasien" text="Nama Pasien" prefWidth="180.0"/>
                <TableColumn fx:id="colNamaDokter" text="Dokter Tujuan" prefWidth="200.0"/>
                <TableColumn fx:id="colTingkatUrgensi" text="Triase Urgensi" prefWidth="130.0"/>
                <TableColumn fx:id="colStatus" text="Status Antrean" prefWidth="120.0"/>
                <TableColumn fx:id="colKeluhan" text="Keluhan Utama" prefWidth="280.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button fx:id="btnHalamanSebelumnya" text="← Sebelumnya" onAction="#handleHalamanSebelumnya" styleClass="btn-outline" disable="true"/>
            <Label fx:id="lblInfoHalaman" text="Memuat halaman..." styleClass="text-muted"/>
            <Button fx:id="btnHalamanBerikutnya" text="Berikutnya →" onAction="#handleHalamanBerikutnya" styleClass="btn-outline" disable="true"/>
        </HBox>
    </VBox>
</VBox>
